{
  "name": "telegram-webhook-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "vercel-build": "pnpm --filter @workspaces/telegram-contracts build",
    "lint": "eslint api src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/main.ts",
    "telegram:setup": "tsx src/cli/main.ts telegram:setup"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@workspaces/telegram-contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
