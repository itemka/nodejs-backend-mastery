# Artsem Automation Hub (@artsem_automation_bot). This app alone owns the bot.
APP_BASE_URL=https://telegram-webhook-hub.vercel.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Use a hub-specific Redis database or namespace; never the backup job prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HUB_KEY_PREFIX=telegram-hub:prod

# One independent bearer token per integration, also configured at its receiver.
# Replace the token placeholder with at least 32 random characters.
HUB_INTEGRATIONS='[{"id":"nb-prod","commands":["status","backup_status"],"url":"https://notion-backup-automation.vercel.app/api/integrations/telegram","token":"<integration bearer token>"}]'

# Preserves existing unprefixed backup buttons and confirmation messages.
HUB_LEGACY_INTEGRATION_ID=nb-prod
