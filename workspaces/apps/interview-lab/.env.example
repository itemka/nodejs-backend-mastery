NODE_ENV=development
# Host process only; the container image listens on 0.0.0.0.
HOST=127.0.0.1
PORT=3100

# Compose host ports; container ports stay 3000, 5432 and 6379.
APP_PORT=3100
POSTGRES_PORT=5433
REDIS_PORT=6380
POSTGRES_USER=lab
POSTGRES_DB=interview_lab
# Disposable local data only. Use a separate secret for any deployed database.
POSTGRES_PASSWORD=local-lab-only
