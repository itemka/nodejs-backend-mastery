{
  "name": "notion-backup-automation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "vercel-build": "pnpm --filter @workspaces/telegram-contracts build",
    "lint": "eslint api src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:drive": "NBA_LIVE_DRIVE=1 vitest run --config vitest.live.config.ts tests/live/drive-access.live.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "cli": "tsx src/cli/main.ts",
    "auth:google": "tsx src/cli/main.ts auth:google",
    "auth:notion": "tsx src/cli/main.ts auth:notion",
    "drive:check": "tsx src/cli/main.ts drive:check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@sparticuz/chromium": "153.0.0",
    "@upstash/qstash": "^2.12.1",
    "@upstash/redis": "^1.39.0",
    "google-auth-library": "^11.3.1",
    "playwright-core": "1.63.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "@workspaces/telegram-contracts": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^25.6.0",
    "@types/yauzl": "^3.4.0",
    "@workspaces/cli-output": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "telegram-webhook-hub": "workspace:*"
  }
}
