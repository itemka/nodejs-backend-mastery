{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/health.ts": { "maxDuration": 10 },
    "api/jobs/process/[jobId].ts": {
      "maxDuration": 300,
      "includeFiles": "../../../node_modules/.pnpm/@sparticuz+chromium@*/node_modules/@sparticuz/chromium/bin/**"
    },
    "api/cron/daily.ts": {
      "maxDuration": 300,
      "includeFiles": "../../../node_modules/.pnpm/@sparticuz+chromium@*/node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 4 * * *" }]
}
