# Template for .env.local: copy it, run `chmod 600 .env.local`, and fill the empty values from the
# 1Password note "Notion Backup Agent". Never commit real values; an empty value counts as unset.
# Schema and defaults: src/config/env.ts (add new keys in both places).

# App: APP_ENV is dev locally, prod for the production bootstrap. APP_BASE_URL is always your
# deployment's production origin, e.g. https://notion-backup-automation.vercel.app for this
# repo's. APP_ENCRYPTION_KEY: `openssl rand -base64 32`, once.
APP_ENV=dev
APP_BASE_URL=
APP_ENCRYPTION_KEY=

# Upstash Redis `notion-backup-state`
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (EU)
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Google Desktop OAuth client and Drive. `auth:google` fills GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_ROOT_FOLDER_ID=

# Google Web OAuth client (phone re-login) and the only account allowed to use it
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
OWNER_GOOGLE_EMAIL=

# Notion workspace URL and its exact name in the workspace switcher
NOTION_WORKSPACE_URL=
NOTION_WORKSPACE_NAME=
# NOTION_AUTO_LOGIN_ENABLED=false

# Gemini supervisor. The model defaults to gemini-3.6-flash; provider none skips model calls.
GEMINI_API_KEY=
AGENT_MODEL_NAME=
# AGENT_MODEL_PROVIDER=gemini

# Telegram hub: this integration's token, not the bot token or webhook secret. Notifications also
# need NOTIFIERS=console,telegram; the integration ID defaults to nb-<APP_ENV>.
TELEGRAM_HUB_URL=https://telegram-webhook-hub.vercel.app
TELEGRAM_HUB_TOKEN=
# TELEGRAM_INTEGRATION_ID=nb-prod

# Vercel endpoint auth (`openssl rand -base64 32` each) and the healthchecks.io ping URL
MCP_AUTH_TOKEN=
CRON_SECRET=
HEARTBEAT_PING_URL=

# Optional tuning
# LOG_LEVEL=info
# AUTO_START_ENABLED=false
# BACKUP_TIME_ZONE=Europe/Warsaw
# BACKUP_DAY_OF_MONTH=1
# EMAIL_WAIT_TIMEOUT_HOURS=48
# MAX_EXPORT_ATTEMPTS=3
# MAX_STAGE_RETRIES=3
# JOB_MAX_LIFETIME_HOURS=168
# TRANSFER_MODE=tmp
# WRITE_SHA256_SIDECAR=true
# NOTIFIERS=console
# EXPORT_SHRINK_RATIO=0.5
# LOGIN_WARNING_DAYS=30,7,1
# MCP_ALLOWED_ORIGINS=
# AGENT_MAX_DECISIONS_PER_INCIDENT=4
# AGENT_MAX_INCIDENTS_PER_JOB=3
# AGENT_MAX_DECISIONS_PER_DAY=20
# AGENT_TIMEOUT_MS=20000
