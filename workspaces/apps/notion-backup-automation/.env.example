# Template for .env.local: copy it, run `chmod 600 .env.local`, and fill values from 1Password.
# Never commit real values. Keys are added here together with their schema in src/config/env.ts.
# An empty value counts as unset. Each function validates only its own subset of these keys.

# prod, dev or test. Locally: dev, or prod for the production bootstrap commands.
APP_ENV=
LOG_LEVEL=

# Upstash Redis `notion-backup-state` (1Password). Also used by `test:live`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encrypts the Notion storageState: `openssl rand -base64 32`, once (1Password).
APP_ENCRYPTION_KEY=

# QStash (EU). The URL is fixed. Locally, the token and APP_BASE_URL (the production origin) let
# smoke:qstash publish its ping, and auth:notion wake a prod job that waited for the login.
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_BASE_URL=

# Google OAuth client (1Password). `auth:google` writes GOOGLE_REFRESH_TOKEN here itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_ROOT_FOLDER_ID=

# Notion workspace: its app URL, and the name shown in the workspace switcher (the session
# gate requires an exact match).
NOTION_WORKSPACE_URL=
NOTION_WORKSPACE_NAME=

# Supervisor (not built yet): gemini (default) or none. The worker and cron require
# GEMINI_API_KEY while the provider is gemini, although nothing calls Gemini yet.
AGENT_MODEL_PROVIDER=
AGENT_MODEL_NAME=
GEMINI_API_KEY=

# Telegram notifications and commands go only through the independently deployed hub.
# The token is this integration's credential in the hub's HUB_INTEGRATIONS registry.
# Generate with `openssl rand -base64 32`; do not use the bot token or webhook secret here.
TELEGRAM_HUB_URL=https://telegram-webhook-hub.vercel.app
TELEGRAM_HUB_TOKEN=
# Defaults to nb-<APP_ENV>; register a matching hub route for each environment you enable.
# TELEGRAM_INTEGRATION_ID=nb-prod

# Bearer tokens: `openssl rand -base64 32` each (1Password). MCP_AUTH_TOKEN needs at least 32
# characters; your shell's copy for MCP clients is NOTION_BACKUP_MCP_TOKEN.
MCP_AUTH_TOKEN=
CRON_SECRET=

# healthchecks.io ping URL (period 1 day, grace 1 day); the daily cron pings it. Vercel only.
HEARTBEAT_PING_URL=

# Optional tuning; the defaults are in src/config/env.ts.
# AUTO_START_ENABLED=false
# BACKUP_TIME_ZONE=Europe/Warsaw
# BACKUP_DAY_OF_MONTH=1
# EMAIL_WAIT_TIMEOUT_HOURS=48
# MAX_EXPORT_ATTEMPTS=3
# MAX_STAGE_RETRIES=3
# JOB_MAX_LIFETIME_HOURS=168
# TRANSFER_MODE=tmp
# WRITE_SHA256_SIDECAR=true
# NOTIFIERS=console
# EXPORT_SHRINK_RATIO=0.5
# LOGIN_WARNING_DAYS=30,7,1
# MCP_ALLOWED_ORIGINS=
# AGENT_MAX_DECISIONS_PER_INCIDENT=4
# AGENT_MAX_INCIDENTS_PER_JOB=3
# AGENT_MAX_DECISIONS_PER_DAY=20
# AGENT_TIMEOUT_MS=20000
